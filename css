/* Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* Body */
body {
    font-family: 'Poppins', sans-serif;
    background: #0f172a;
    color: #fff;
}

/* Header */
header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 60px;
    background: #020617;
    border-bottom: 1px solid #1e293b;
}

.logo {
    font-size: 26px;
    font-weight: bold;
    color: #38bdf8;
}

/* Nav */
nav a {
    margin-left: 25px;
    text-decoration: none;
    color: #cbd5f5;
    transition: 0.3s;
}

nav a:hover {
    color: #38bdf8;
    text-shadow: 0 0 8px #38bdf8;
}

/* Hero */
.hero {
    text-align: center;
    padding: 120px 20px;
}

.hero h1 {
    font-size: 50px;
    color: #38bdf8;
    text-shadow: 0 0 15px #38bdf8;
}

.hero p {
    margin-top: 15px;
    font-size: 18px;
    color: #94a3b8;
}

.hero button {
    margin-top: 25px;
    padding: 12px 30px;
    border-radius: 25px;
    border: none;
    background: #38bdf8;
    color: #0f172a;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
}

/* Glow effect */
.hero button:hover {
    background: #0ea5e9;
    box-shadow: 0 0 15px #38bdf8;
    transform: scale(1.1);
}

/* Section */
section {
    padding: 60px 20px;
    text-align: center;
}

/* About */
.about p {
    max-width: 700px;
    margin: auto;
    color: #94a3b8;
}

/* Grid */
.project-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
    margin-top: 40px;
}

/* Cards */
.card {
    background: #020617;
    padding: 25px;
    border-radius: 15px;
    border: 1px solid #1e293b;
    transition: 0.4s;
}

/* Neon hover */
.card:hover {
    transform: translateY(-10px);
    border-color: #38bdf8;
    box-shadow: 0 0 20px #38bdf8;
}

/* Text */
section p {
    margin-top: 10px;
    color: #94a3b8;
}

/* Contact */
.contact p {
    margin: 10px 0;
}

/* Footer */
footer {
    background: #020617;
    text-align: center;
    padding: 20px;
    color: #94a3b8;
    border-top: 1px solid #1e293b;
}

/* Responsive */
@media(max-width: 768px) {
    header {
        flex-direction: column;
    }

    nav {
        margin-top: 10px;
    }

    .hero h1 {
        font-size: 32px;
    }
}
